# Local storage
BRIDGE_DB_PATH=./data/bridge.db
BRIDGE_POLL_INTERVAL_MS=300000
BRIDGE_TIME_ZONE=Asia/Seoul

# DaouOffice read-only browser automation
# The first login uses a dedicated local Chrome profile. Never copy this profile to Git or another PC.
DAOU_OFFICE_URL=https://hug.hunet.co.kr/app/asset
DAOU_OFFICE_CALENDAR_URL=https://hug.hunet.co.kr/app/calendar
DAOU_CHROME_PROFILE_DIR=./data/daou-office-chrome-profile
DAOU_BROWSER_REMOTE_DEBUG_PORT=9222
DAOU_CHROME_EXECUTABLE_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# Slack Socket Mode app
# Never commit real tokens. xapp-* is the app-level token; xoxb-* is the bot token.
SLACK_APP_TOKEN=xapp-replace-me
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_SOURCE_CHANNEL_ID=C_REPLACE_SOURCE
SLACK_REQUEST_CHANNEL_ID=C_REPLACE_REQUEST
# Recommended: restrict source ingestion to the NineHire Slack app bot_id.
SLACK_NINEHIRE_BOT_ID=B_REPLACE_NINEHIRE

# NineHire MCP
NINEHIRE_MCP_URL=https://api.ninehire.com/developer/mcp
# Dashboard candidate detail link. Use your NineHire workspace base URL only.
NINEHIRE_APP_URL=https://app.ninehire.com/your-workspace
NINEHIRE_MCP_API_KEY=replace-me
# Confirm these two values against the connection snippet shown by NineHire.
NINEHIRE_MCP_AUTH_HEADER=Authorization
# Leave empty if NineHire instructs you to send the key without a scheme.
NINEHIRE_MCP_AUTH_SCHEME=Bearer
NINEHIRE_MCP_TIMEOUT_MS=30000

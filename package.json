{
  "name": "interview-arrangement-bridge-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local MCP bridge for NineHire interview workflows and Slack availability collection.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:mcp": "tsx src/mcp/main.ts",
    "dev:worker": "tsx src/worker/main.ts",
    "dev:dashboard": "npm run build && next dev apps/dashboard --hostname 127.0.0.1 --port 3100",
    "backup:db": "tsx src/cli/backup-database.ts",
    "inspect:ninehire": "tsx src/cli/inspect-ninehire.ts",
    "inspect:slack-source": "tsx src/cli/inspect-slack-source.ts",
    "daou:login": "tsx src/cli/open-daou-office.ts",
    "start:mcp": "node dist/src/mcp/main.js",
    "start:worker": "node dist/src/worker/main.js",
    "build:dashboard": "npm run build && next build apps/dashboard",
    "start:dashboard": "next start apps/dashboard --hostname 127.0.0.1 --port 3100",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@slack/bolt": "^5.0.0",
    "@slack/types": "^3.0.0",
    "@slack/web-api": "^8.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "playwright-core": "^1.62.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@hono/node-server": "2.0.11"
  }
}
